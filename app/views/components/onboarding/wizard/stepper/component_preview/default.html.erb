<%
steps = [
    { step: 'Welcome', status: :complete },
    { step: 'Database', status: :active },
    { step: 'Network' },
    { step: 'Finish' }
].freeze
%>

<div class="mx-auto max-w-[300px]">
    <%= component 'onboarding/wizard/stepper', steps: do |component| %>
        <% steps.each_with_index do |step, index| %>
            <%= component.with_step(index:, **step) %>
        <% end %>
    <% end %>
</div>
