<div class="mx-auto max-w-sm">
    <%= form_with url: "#", scope: :listing, method: :get, builder: TailwindFormBuilder do |form| %>
        <%= form.text_field :price,
                            leading: tag.span("$", class: "text-ink-3 text-sm"),
                            trailing: tag.span("USD", class: "text-ink-3 text-sm") %>
    <% end %>
</div>
