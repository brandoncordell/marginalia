<h2 class="text-xl font-display mb-1">Metadata provider</h2>
<p class="text-sm text-muted mb-4">Where book details and covers are looked up.</p>

<%= form_with model: @settings, url: setup_path, method: :patch do |f| %>
  <%= hidden_field_tag :step, "metadata" %>

  <% if @settings.errors.any? %>
    <ul class="mb-3 text-sm text-red-600">
      <% @settings.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>

  <%= f.select :metadata_provider,
        Setting::METADATA_PROVIDERS.map { |p| [p.titleize, p] },
        { selected: @settings.metadata_provider || "open_library" },
        class: "input w-full" %>

  <%# Open Library needs no key; others do. A Stimulus controller could toggle this. %>
  <%= f.password_field :metadata_api_token,
        placeholder: "API token (only for providers that require one)",
        class: "input mt-3 w-full" %>

  <div class="mt-5 flex items-center justify-between">
    <%= link_to "Back", setup_path(step: "library"), class: "text-sm text-muted hover:text-default" %>
    <%= f.submit "Continue", class: "btn-primary" %>
  </div>
<% end %>
