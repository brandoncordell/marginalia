<h2 class="text-xl font-display mb-1">Library location</h2>
<p class="text-sm text-muted mb-4">Where Marginalia stores covers, uploads, and metadata.</p>

<%= form_with model: @settings, url: setup_path, method: :patch do |f| %>
  <%= hidden_field_tag :step, "library" %>

  <% if @settings.errors.any? %>
    <ul class="mb-3 text-sm text-red-600">
      <% @settings.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %>
    </ul>
  <% end %>

  <%= f.text_field :library_path,
        value: @settings.library_path.presence || ENV.fetch("MARGINALIA_DATA_DIR", "/config"),
        class: "input w-full" %>

  <div class="mt-5 flex items-center justify-between">
    <%= link_to "Back", setup_path(step: "account"), class: "text-sm text-muted hover:text-default" %>
    <%= f.submit "Continue", class: "btn-primary" %>
  </div>
<% end %>
