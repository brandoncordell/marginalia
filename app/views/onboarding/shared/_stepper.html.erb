<ol class="flex items-center justify-center gap-2 text-xs font-mono">
  <% Setting::ONBOARDING_STEPS.each_with_index do |step, i| %>
    <% reached = i <= Current.setting.furthest_index %>
    <% active  = step == current %>
    <li>
      <% if reached %>
        <%= link_to step.titleize, Onboarding::Steps.path_for(step),
              class: "px-2 py-1 rounded #{active ? 'bg-accent text-white' : 'text-muted hover:text-default'}" %>
      <% else %>
        <span class="px-2 py-1 rounded text-muted/50"><%= step.titleize %></span>
      <% end %>
    </li>
  <% end %>
</ol>
